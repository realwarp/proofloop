# Temporary development inference only (NVIDIA API Catalog or another accessible compatible API).
# Use the exact model ID available for your key. Never put a real key in this template.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b

# For approved Nebius AI Cloud endpoint inference, configure the SAME LLM_* variables above:
# LLM_API_KEY=<generated endpoint bearer token>
# LLM_BASE_URL=https://<endpoint-public-host>/v1
# LLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
# Do not create a billable endpoint until the AI Cloud billing/cost gate is satisfied.

# Optional Token Factory-only diagnostic path; these are NOT AI Cloud credentials.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Local API server
PORT=8787
HOST=127.0.0.1

# Optional integrations (add only when actually wired into the product).
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=proofloop
