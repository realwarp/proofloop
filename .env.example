# Temporary development inference only (NVIDIA API Catalog).
# Use the exact model ID shown as available for your NVIDIA API key.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Required for the Nebius infrastructure gate and final hackathon integration.
# Never commit actual values. The project ID is not the API key.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Local API server
PORT=8787
HOST=127.0.0.1

# Optional integrations (add only when actually wired into the product).
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=proofloop
