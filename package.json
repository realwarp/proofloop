{
  "name": "proofloop",
  "version": "0.1.0",
  "private": true,
  "description": "Research-grounded AI coding agent with executable verification",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:model": "tsx src/smoke-test.ts",
    "test": "tsx --test src/**/*.test.ts",
    "preflight:nebius": "node scripts/nebius-preflight.mjs",
    "preflight:sandbox": "python scripts/sandbox-smoke.py",
    "fixture:install": "npm --prefix fixtures/express-wildcard-migration install",
    "fixture:test": "npm --prefix fixtures/express-wildcard-migration test",
    "verify:fixture": "node scripts/verify-migration-fixture.mjs",
    "preflight:ai-cloud": "node scripts/ai-cloud-preflight.mjs",
    "test:e2e:migration": "node scripts/e2e-migration-check.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
