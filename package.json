{
  "name": "proofloop",
  "version": "0.1.0",
  "private": true,
  "description": "Research-grounded AI coding agent with executable verification",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:model": "tsx src/smoke-test.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
